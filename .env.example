# FalkorDB Configuration
# For local Docker:
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FALKORDB_SSL=false

# For FalkorDB Cloud / Remote instance:
FALKORDB_HOST=r-6jissuruar.instance-ajpf8rtg5.hc-7up0crkyn.ap-south-1.aws.f2e0a955bb84.cloud
FALKORDB_PORT=63692
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=password
FALKORDB_SSL=false
FALKORDB_GRAPH=asof

# App & Server Settings
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0

# LLM Configuration (for AsOf explanation agent)
# Provider options: 'mock', 'openai', 'anthropic', 'gemini'
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
